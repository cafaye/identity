#!/usr/bin/env bash
#
# Measure the credential audit's answer, per ROLE, against a real Postgres.
#
# WHY THIS EXISTS. `migrations/00016_account_isolation.sql` embeds a COPY of
# kit's `templates/database/tenancy/substrate.sql`, taken before kit-rls-advisor-02
# replaced `credential_tables()`'s regexp with a `pg_depend` walk. Nothing in
# this repository compared the copy against the template again, so the copy
# drifted and the audit it answers went wrong in a way no test could see.
#
# THE FAILURE IS ROLE-DEPENDENT, AND THAT IS THE WHOLE OF IT. The old query
# reads the column name out of `pg_get_expr(polqual, polrelid)`, and
# `pg_get_expr` omits the schema of a name the READER could resolve — where the
# reader is the session, `"$user"` is a `search_path` entry, and kit's cluster
# admin role is `cafaye` (`KIT_POSTGRES_USER: ${KIT_POSTGRES_USER:-cafaye}` in
# `templates/compose/docker-compose.yml`). So the qualifier this repository's
# migration writes deparses as
#
#     (token_digest = ( SELECT cafaye.current_credential_digest() AS …))
#
# for a role with no schema of its own, and as
#
#     (token_digest = ( SELECT current_credential_digest() AS …))
#
# for the role named after this platform, whose `"$user"` schema IS `cafaye`.
# The old regexp requires the literal `cafaye.` so it matches the first and NOT
# the second: the audit returned NOTHING in the session that runs it as the
# cluster's own admin role, and the whole answer in every other one. Same
# database, same policy, same instant.
#
# "No table here can be resolved without an account" is precisely what an
# operator auditing credentials as `cafaye` is then told, and it is the one
# answer that reads as a clean bill of health. This script exists to make that
# difference a NUMBER rather than a claim, and to keep it one: it prints both
# answers for both roles, on a scratch cluster, every run.
#
# WHAT IT IS NOT. It is not a gate. It needs a container runtime and takes about
# a minute, and `bin/prime` runs on a bare CI runner. The check that belongs in
# the gate is `bin/credential-audit-drift --expect-fixed`, and the reason it can
# be there at all is that it needs no database for that half — see
# `internal/platform/ci/substrate_copy_test.go`, which compares this repository's
# `credential_tables()` against kit's and fails on a difference.
#
# USAGE
#
#   bin/credential-audit-drift                 # measure, print both answers
#   bin/credential-audit-drift --keep          # leave the cluster up to poke at
#
# COSTS, IN THE ORDER THEY MATTER. It creates ONE container named
# `identity-credential-audit-drift` on a port it takes from CAF_DRIFT_PORT
# (default 55432) and it DROPS it on every exit path including an interrupt. The
# port is outside caf's block 15000-15999 so a parallel worker cannot collide
# with it and will not avoid it.

set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root" || exit 1

container="identity-credential-audit-drift"
port="${CAF_DRIFT_PORT:-55432}"
keep=0
[ "${1:-}" = "--keep" ] && keep=1

cleanup() {
  [ "$keep" = "1" ] && {
    echo
    echo "kept: docker exec -it $container psql -U cafaye -d identity"
    return
  }
  docker rm -f "$container" >/dev/null 2>&1
}
trap cleanup EXIT INT TERM

fail() {
  echo "credential-audit-drift: $*" >&2
  exit 1
}

command -v docker >/dev/null 2>&1 || fail "no docker on PATH; this measurement needs a real Postgres"
docker info >/dev/null 2>&1 || fail "docker is installed and not answering; a container runtime that is not running proves nothing"

docker rm -f "$container" >/dev/null 2>&1
docker run -d --name "$container" \
  -e POSTGRES_PASSWORD=cafaye -e POSTGRES_USER=identity -e POSTGRES_DB=identity \
  -p "$port:5432" postgres:17-alpine >/dev/null || fail "could not start the scratch cluster"

# The image creates its role on first init; wait for it rather than sleeping on it.
for _ in $(seq 1 60); do
  docker exec "$container" pg_isready -U identity -d identity >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$container" pg_isready -U identity -d identity >/dev/null 2>&1 ||
  fail "the scratch cluster never became ready"

# psql inside the container as a superuser, so the roles below exist before any
# migration needs one. kit's cluster provisions `<service>` and `<service>_app`;
# `protect_table` refuses a table it cannot find a login role for, so without
# these the migration loop would fail on a fact about the cluster and not about
# the audit.
q() { docker exec -i "$container" psql -v ON_ERROR_STOP=1 -q -tA -U "$1" -d identity; }

q identity >/dev/null <<'SQL'
create role identity_app login;
SQL

for migration in migrations/0*.sql; do
  bin/migration-up-section "$migration" |
    docker exec -i "$container" psql -v ON_ERROR_STOP=1 -q -U identity -d identity >/dev/null 2>&1 ||
    { bin/migration-up-section "$migration" |
        docker exec -i "$container" psql -v ON_ERROR_STOP=1 -q -U identity -d identity >&2
      fail "migration failed: $migration"; }
done

# `cafaye` is kit's cluster admin role name, and `$user` resolving it to the
# `cafaye` schema is what makes the deparsed spelling lose its prefix. Create it
# AFTER the migration so nothing in the migration could have depended on it.
q identity >/dev/null <<'SQL'
create role cafaye superuser login;
SQL

# Kit's CURRENT credential_tables(), installed beside the copy under its own
# name so both run against the same catalog in the same session. Copied out of
# `kit/templates/database/tenancy/substrate.sql` at kit commit efa49e5; the
# comparison against that file is `internal/platform/ci/substrate_copy_test.go`,
# so this body and the template cannot disagree without a red build.
q identity >/dev/null <<'SQL'
create or replace function cafaye.credential_tables_current()
returns table (table_schema text, table_name text, digest_column text)
language sql
stable
as $caf$
  with digest_fn as (
    select fn.oid
      from pg_proc fn
      join pg_namespace fns on fns.oid = fn.pronamespace
     where fns.nspname = 'cafaye'
       and fn.proname = 'current_credential_digest'
       and fn.pronargs = 0
  ),
  resolve as (
    select pol.oid as policy_oid,
           pol.polrelid,
           att.attname as column_name
      from pg_policy pol
      join pg_depend fd
        on fd.classid = 'pg_policy'::regclass
       and fd.objid = pol.oid
       and fd.refclassid = 'pg_proc'::regclass
       and fd.deptype = 'n'
      join digest_fn df on df.oid = fd.refobjid
      left join pg_depend cd
        on cd.classid = 'pg_policy'::regclass
       and cd.objid = pol.oid
       and cd.refclassid = 'pg_class'::regclass
       and cd.refobjid = pol.polrelid
       and cd.refobjsubid > 0
      left join pg_attribute att
        on att.attrelid = pol.polrelid
       and att.attnum = cd.refobjsubid
       and not att.attisdropped
     where pol.polname like '%!_cafaye!_resolve' escape '!'
       and pol.polcmd = 'r'
  )
  select n.nspname::text,
         c.relname::text,
         case
           when count(*) = 1 then min(column_name)
           when count(*) >= 1 then '(unresolved)'
         end
    from resolve r
    join pg_class c on c.oid = r.polrelid
    join pg_namespace n on n.oid = c.relnamespace
   group by n.nspname, c.relname
   order by n.nspname, c.relname
$caf$;
SQL

echo "the credential table, created the way migrations/00016 creates it:"
echo "  select cafaye.protect_credential_table('api_keys', 'token_digest');"
echo
echo "what the catalog prints, per role — same policy, same instant:"
for role in identity cafaye; do
  printf '  as %-9s %s\n' "$role" \
    "$(q "$role" <<<"select pg_get_expr(polqual, polrelid) from pg_policy where polname = 'api_keys_cafaye_resolve'")"
done
echo
echo "the audit, per role and per version:"
printf '  %-9s %-24s %s\n' role rows digest_column
for role in identity cafaye; do
  old=$(q "$role" <<<"select coalesce(string_agg(table_name || '/' || coalesce(digest_column,'NULL'), ','), '(none)') from cafaye.credential_tables()")
  new=$(q "$role" <<<"select coalesce(string_agg(table_name || '/' || coalesce(digest_column,'NULL'), ','), '(none)') from cafaye.credential_tables_current()")
  printf '  %-9s %-24s %s\n' "$role" "OLD (in 00016)" "$old"
  printf '  %-9s %-24s %s\n' "$role" "NEW (kit efa49e5)" "$new"
done
echo
echo "The old query is not wrong for every role, which is the whole defect: it is"
echo "right for a role with no schema of its own and silent for the one an"
echo "operator auditing credentials is logged in as."